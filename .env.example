# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Model tiering: cheaper model runs the 6 strategy agents, stronger model writes the final dashboard
STRATEGY_MODEL=claude-sonnet-5
DECISION_MODEL=claude-opus-5

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-1001234567890

# Watchlist: comma-separated VN tickers
STOCK_LIST=FPT,VNM,HPG,VCB

# Concurrency cap for parallel strategy-agent calls
MAX_CONCURRENT_AGENTS=6
